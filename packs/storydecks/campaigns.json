    {
      "id": "small-town-start",
      "name": "Small Town Campaign Start",
      "description": "A grounded beginning for a party that starts life in a quiet frontier town. Most of the cards go into the bonds between the characters and the texture of the place they call home, then a few institutions, rivalries, and half-buried secrets are salted in. By the end you should have a town that feels lived-in, a web of relationships the players actually care about, and two or three loose threads the GM can pull on whenever the campaign needs a direction.",
      "type": "premade",
      "tags": ["New Campaign"],
      "minPlayers": 3,
      "requiredPlayers": 3,
      "maxPlayers": 6,
      "expectedCards": 12,
      "allowManualSubstitution": true,
      "allowReordering": true,
      "avoidDuplicateCards": true,
      "focus": [
        "Build connections between characters.",
        "Define what makes the town unique.",
        "Seed a few unresolved problems.",
        "Leave two or three adventure hooks."
      ],
