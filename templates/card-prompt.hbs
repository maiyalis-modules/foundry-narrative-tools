{{!-- Player-facing card popup: what the card has established so far, this
      player's setup + question, and the pass instruction. --}}
<div class="card-prompt__body">
  {{#if hasHistory}}
    <section class="card-prompt__history">
      <h3 class="card-prompt__history-heading">{{localize "FSD.SoFar"}}</h3>
      {{#each history as |h|}}
        <div class="card-prompt__history-entry">
          <p class="card-prompt__history-q">{{h.question}}</p>
          <p class="card-prompt__history-a"><strong>{{h.who}}:</strong> {{h.answer}}</p>
        </div>
      {{/each}}
    </section>
  {{/if}}

  {{#if setup}}
    <p class="card-prompt__setup">{{setup}}</p>
  {{/if}}

  <div class="card-prompt__field">
    <label for="cp-answer">{{question}}</label>
    <textarea id="cp-answer" data-answer rows="4"></textarea>
  </div>

  {{#if canChooseNext}}
    <div class="card-prompt__field card-prompt__handoff">
      <label for="cp-next">
        <i class="fa-solid fa-hand-point-right"></i>
        <span><strong>{{localize "FSD.ThenPass"}}</strong> {{handoff}}</span>
      </label>
      <select id="cp-next" data-next-player>
        {{#each candidates as |c|}}
          <option value="{{c.id}}">{{c.name}}</option>
        {{/each}}
      </select>
    </div>
  {{else}}
    {{#if handoffNoPlayers}}
      <p class="card-prompt__spotlight">
        <i class="fa-solid fa-hand-point-right"></i>
        <span><strong>{{localize "FSD.ThenPass"}}</strong> {{handoff}} — {{localize "FSD.HandoffGMWillContinue"}}</span>
      </p>
    {{/if}}
  {{/if}}

  <div class="card-prompt__actions">
    <button type="button" class="story-deck__primary" data-fsd="submit">
      {{localize "FSD.Submit"}}
    </button>
  </div>
</div>
